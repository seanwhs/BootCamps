## Final Code: The Complete Welcome Script

Save this as `welcome.py` to see a summary of your toolkit:

```python
#!/usr/bin/env python3
"""
welcome.py - Complete Toolkit Summary
"""

import os
import sys
import json
from datetime import datetime

# Add toolkit to path
sys.path.insert(0, os.path.expanduser('~/hacking-toolkit'))

try:
    from utils.config import config
    from utils.logger import logger
except ImportError:
    print("[!] Toolkit not found at ~/hacking-toolkit")
    sys.exit(1)

class Welcome:
    def __init__(self):
        self.toolkit_dir = os.path.expanduser('~/hacking-toolkit')
        self.modules = self._discover_modules()
    
    def _discover_modules(self):
        """Discover available modules"""
        modules = []
        for category in ['recon', 'web-attack', 'exploit', 'post-exploit']:
            path = os.path.join(self.toolkit_dir, category)
            if os.path.exists(path):
                for file in os.listdir(path):
                    if file.endswith('.py') and not file.startswith('__'):
                        modules.append({
                            'category': category,
                            'name': file,
                            'path': os.path.join(path, file)
                        })
        return modules
    
    def display(self):
        """Display welcome message"""
        print("="*70)
        print("  PYTHON FOR HACKERS - COMPLETE TOOLKIT")
        print("  Version: 2.0.0")
        print("="*70)
        print(f"\n  Toolkit Directory: {self.toolkit_dir}")
        print(f"  Modules Found: {len(self.modules)}")
        print(f"  Current Time: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        print("\n" + "="*70)
        print("\n  📚 MODULE CATEGORIES:")
        print("  " + "-"*60)
        
        categories = {}
        for module in self.modules:
            cat = module['category']
            if cat not in categories:
                categories[cat] = []
            categories[cat].append(module['name'])
        
        for cat, files in categories.items():
            print(f"\n  [{cat.upper()}]")
            for file in sorted(files):
                print(f"    ✓ {file}")
        
        print("\n" + "="*70)
        print("  🚀 QUICK START COMMANDS:")
        print("  " + "-"*60)
        print("    cd ~/hacking-toolkit")
        print("    source venv/bin/activate")
        print("    python3 recon/port_scanner.py 127.0.0.1 -p 22,80,443")
        print("    python3 web-attack/brute_forcer.py https://example.com -w common")
        print("    python3 exploit/exploit_framework.py http://target/page.php?id=1 --all")
        print("    python3 post-exploit/c2_server.py")
        
        print("\n" + "="*70)
        print("  📖 RESOURCES:")
        print("  " + "-"*60)
        print("    Main Series: 13 Parts + 5 Appendices + 4 Primers")
        print("    Total Code: 35+ Files, 15,000+ Lines")
        print("    Skills: Networking, Web, Exploitation, C2, Post-Exploit")
        
        print("\n" + "="*70)
        print("  ⚠️  REMEMBER: Use ethically and legally!")
        print("="*70)

if __name__ == "__main__":
    welcome = Welcome()
    welcome.display()
```

